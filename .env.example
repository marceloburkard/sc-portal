# Local development (optional — defaults shown)
PORT=8787

# Required on Vercel: create a Blob store in the dashboard (Storage → Blob)
# and connect it to this project. Vercel sets this token automatically.
BLOB_READ_WRITE_TOKEN=

# Match your Blob store type: "public" (default) or "private"
BLOB_ACCESS=public

# Required on Vercel for the daily cron job (/api/cron/refresh).
# Generate a random string and add it in Project Settings → Environment Variables.
CRON_SECRET=

# Daily match-alert email. Gmail SMTP is used when both Gmail vars are set;
# otherwise Resend is used if RESEND_API_KEY + ALERT_EMAIL_FROM are set.
#
# Gmail (low volume, one destination): enable 2-Step Verification, then
# generate an App Password at https://myaccount.google.com/apppasswords
# — do not use the regular account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Address the daily "new matches" email is sent to.
ALERT_EMAIL_TO=rabelo@insi.com
#
# Resend fallback (https://resend.com) — only needed if Gmail is not set.
# FROM must be a domain verified in Resend; @gmail.com will be rejected.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Canada Buys Tenders <alerts@yourdomain.com>
