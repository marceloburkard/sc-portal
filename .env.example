# Local development (optional — defaults shown)
PORT=8787

# Required on Vercel: create a Blob store in the dashboard (Storage → Blob)
# and connect it to this project. Vercel sets this token automatically.
BLOB_READ_WRITE_TOKEN=

# Match your Blob store type: "public" (default) or "private"
BLOB_ACCESS=public

# Required on Vercel for the daily cron job (/api/cron/refresh).
# Generate a random string and add it in Project Settings → Environment Variables.
CRON_SECRET=

# Daily match-alert email (sent via Resend: https://resend.com)
# 1. Create a free Resend account and generate an API key.
# 2. Either verify your own sending domain in Resend, or (for a quick start)
#    use their shared "onresend.com" testing sender as ALERT_EMAIL_FROM.
RESEND_API_KEY=
# Address the daily "new matches" email is sent to.
ALERT_EMAIL_TO=rabelo@insi.com
# Verified "from" address/domain in your Resend account.
ALERT_EMAIL_FROM=Canada Buys Tenders <alerts@yourdomain.com>
